# Article Submission Bot — environment template
# Copy to .env and fill values. Never commit .env.

# Safety defaults (do not flip casually)
DRY_RUN=true
SAVE_DRAFT=true
ALLOW_FINAL_SUBMISSION=false

# Author / identity
AUTHOR_CONFIG_PATH=config/author.yaml
JOURNALS_CONFIG_PATH=config/journals.yaml
SELECTORS_CONFIG_PATH=config/selectors.yaml

# Institutional (corresponding / Gmail editorial) vs Drive (files)
INSTITUTIONAL_EMAIL=joaopedro.passos@mail.uft.edu.br
DRIVE_EMAIL=jp.criatividade@gmail.com
GMAIL_EMAIL=joaopedro.passos@mail.uft.edu.br

# Google OAuth — SEPARATE clients/tokens per service (never mix)
# Drive client (jp.criatividade@gmail.com)
GOOGLE_DRIVE_CLIENT_SECRETS=secrets/drive_client_secrets.json
GOOGLE_DRIVE_TOKEN=secrets/drive_token.json
GOOGLE_DRIVE_SCOPES=https://www.googleapis.com/auth/drive.readonly

# Gmail client (joaopedro.passos@mail.uft.edu.br) — drafts only
GOOGLE_GMAIL_CLIENT_SECRETS=secrets/gmail_client_secrets.json
GOOGLE_GMAIL_TOKEN=secrets/gmail_token.json
GOOGLE_GMAIL_SCOPES=https://www.googleapis.com/auth/gmail.compose,https://www.googleapis.com/auth/gmail.readonly

# Paths
DATA_DIR=data
STORAGE_DIR=storage
AUDIT_DIR=data/audit
PACKAGES_DIR=data/packages
ORIGINALS_DIR=data/originals
WORKING_DIR=data/working
QUARANTINE_DIR=data/quarantine
SQLITE_URL=sqlite:///storage/article_bot.db

# Confirmation / final submit
CONFIRMATION_TTL_SECONDS=900
FINAL_AUTH_DIR=/tmp
FINAL_AUTH_PREFIX=article_bot_final_auth_

# Playwright
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_TIMEOUT_MS=30000
BROWSER_AUTH_DIR=playwright/.auth

# API
API_HOST=127.0.0.1
API_PORT=8000
LOG_LEVEL=INFO

# Simultaneous submission guard
BLOCK_SIMULTANEOUS_SUBMIT=true
